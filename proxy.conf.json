{
  "/api/token": {
    "target": "https://accounts.spotify.com",
    "secure": true,
    "changeOrigin": true,
    "logLevel": "debug"
  },
  "/api/spotify": {
    "target": "https://api.spotify.com",
    "secure": true,
    "changeOrigin": true,
    "pathRewrite": {
      "^/api/spotify": "/v1"
    },
    "logLevel": "debug"
  }
}